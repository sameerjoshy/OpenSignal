# ===== Core =====
ENVIRONMENT=development
LOG_LEVEL=debug

# ===== Database (from Supabase) =====
# Local: postgresql+asyncpg://opensignal:opensignal@localhost:5432/opensignal
# Supabase: postgresql://postgres:password@db.supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://opensignal:opensignal@localhost:5432/opensignal

# ===== Cache / Queue (from Upstash) =====
REDIS_URL=redis://default:password@host:port

# ===== Security =====
# Generate with: openssl rand -base64 64
JWT_SECRET=your-256-bit-secret-here
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AES-256 encryption key for service credentials (32 bytes, base64).
# Generate with: python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=your-32-byte-base64-key-here

# ===== CORS (comma separated origins) =====
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ===== Supabase Auth (user management) =====
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret from Supabase dashboard (Settings > API > JWT Secret) - used to validate Supabase access tokens
SUPABASE_JWT_SECRET=

# ===== AWS Bedrock (Claude) =====
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ===== Global service keys (optional fallbacks; per-user keys are stored encrypted) =====
APOLLO_API_KEY=
HUNTER_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
SENDGRID_API_KEY=
NEWSAPI_KEY=
HUBSPOT_API_KEY=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_INSTANCE_URL=

# ===== Google Analytics 4 (service account JSON) =====
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=

# ===== Monitoring =====
SENTRY_DSN=