# Backend API URL
# Local dev: use Vite proxy (leave empty) or point directly:
VITE_API_URL=

# Supabase Auth (user management) - optional. When empty the app uses the backend's
# built-in email/password auth against the FastAPI JWT endpoints.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

VITE_ENVIRONMENT=development